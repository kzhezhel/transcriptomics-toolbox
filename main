import scanpy as sc
import squidpy as sq
import pandas as pd
import numpy as np
import tarfile
import os
import glob
import warnings
import plotly.express as px
import plotly.graph_objects as go
import webbrowser
from PIL import Image
import base64
from io import BytesIO
import json
import argparse

warnings.filterwarnings('ignore')
warnings.filterwarnings("ignore", message="The `igraph` implementation of leiden clustering")

parser = argparse.ArgumentParser(
    description="Generate interactive spatial transcriptomics dashboard (3-island) from Visium data."
)
parser.add_argument(
    "--data_dir",
    type=str,
    default=".",
    help="Path to the directory containing the .h5 and spatial archive files (default: current directory)."
)
parser.add_argument(
    "--output",
    type=str,
    default="three_islands_dashboard.html",
    help="Output HTML file name (default: three_islands_dashboard.html)."
)
parser.add_argument(
    "--gene",
    type=str,
    default="SOX2",
    help="Default gene to display (must exist in the dataset)."
)
args = parser.parse_args()

data_dir = os.path.abspath(args.data_dir)
output_file = args.output
default_gene = args.gene

print(f"Looking for data in: {data_dir}")

# File search

h5_files = glob.glob(os.path.join(data_dir, "*filtered_feature_bc_matrix.h5"))
spatial_files = glob.glob(os.path.join(data_dir, "*spatial*.tar.gz")) + glob.glob(
    os.path.join(data_dir, "*spatial*.gz")
)

if not h5_files or not spatial_files:
    raise FileNotFoundError(
        f"No .h5 or spatial archive found in {data_dir}.\n"
        "Please ensure you have exactly one *filtered_feature_bc_matrix.h5 "
        "and one *spatial*.tar.gz (or .gz) file."
    )

h5_file = h5_files[0]
spatial_archive = spatial_files[0]
print(f"Using h5: {os.path.basename(h5_file)}")
print(f"Using spatial: {os.path.basename(spatial_archive)}")

# Распаковка spatial-архива, если ещё не распакован
spatial_dir = os.path.join(data_dir, "spatial")
if not os.path.exists(spatial_dir) or len(os.listdir(spatial_dir)) == 0:
    print("Extracting spatial archive...")
    os.makedirs(spatial_dir, exist_ok=True)
    with tarfile.open(spatial_archive, "r:*") as tar:
        tar.extractall(path=spatial_dir)
    print("Done.")
else:
    print("Using existing spatial directory.")

# Filtering data

warnings.filterwarnings("ignore", message="Variable names are not unique", category=UserWarning)
adata = sq.read.visium(spatial_dir, counts_file=os.path.basename(h5_file))
warnings.resetwarnings()
adata.var_names_make_unique()

print(f"Loaded {adata.n_obs} spots, {adata.n_vars} genes")

if default_gene not in adata.var_names:
    raise ValueError(f"Gene '{default_gene}' not found in the dataset. Available genes: {list(adata.var_names[:10])}...")

sc.pp.filter_cells(adata, min_genes=200)
sc.pp.filter_genes(adata, min_cells=3)
sc.pp.highly_variable_genes(adata, n_top_genes=2000, flavor="seurat_v3")
adata.raw = adata.copy()
adata = adata[:, adata.var.highly_variable].copy()
sc.pp.normalize_total(adata, target_sum=1e8)
sc.pp.log1p(adata)
adata.X = adata.X / np.log(2)
sc.pp.scale(adata, max_value=10)
adata.X = adata.X.astype(np.float32)

sc.tl.pca(adata, svd_solver="arpack")
sc.pp.neighbors(adata, n_neighbors=10, n_pcs=30)
sc.tl.leiden(adata, resolution=0.54, key_added="leiden", flavor="leidenalg")
sc.tl.umap(adata)

# Uploading predicted cell types
deconv_file = os.path.join(data_dir, "lung_cancer_deconvolved_nnls.h5ad")
if os.path.exists(deconv_file):
    adata_deconv = sc.read(deconv_file)
    if (adata.obs_names == adata_deconv.obs_names).all():
        adata.obs['pred_cell_type'] = adata_deconv.obs['pred_cell_type'].values
    else:
        adata.obs['pred_cell_type'] = 'Unknown'
else:
    adata.obs['pred_cell_type'] = 'Unknown'


# Coordinates and imaging

library_id = list(adata.uns['spatial'].keys())[0]
scalefactor = adata.uns['spatial'][library_id]['scalefactors']['tissue_lowres_scalef']
lowres_path = os.path.join(spatial_dir, 'spatial', 'tissue_lowres_image.png')
img = Image.open(lowres_path)
img_width, img_height = img.size
print(f"Lowres image size: {img_width} x {img_height}")

img_buffer = BytesIO()
img.save(img_buffer, format='PNG')
img_base64 = base64.b64encode(img_buffer.getvalue()).decode('utf-8')

coords = adata.obsm['spatial'] * scalefactor
coords[:, 1] = img_height - coords[:, 1]

if 'in_tissue' in adata.obs:
    tissue_mask = adata.obs['in_tissue'].astype(bool)
    coords_tissue = coords[tissue_mask]
    obs_tissue = adata.obs[tissue_mask]
else:
    tissue_mask = np.ones(adata.n_obs, dtype=bool)
    coords_tissue = coords
    obs_tissue = adata.obs

lib_size = adata.obs['total_counts'].values if 'total_counts' in adata.obs else np.array(
    adata.raw.X.sum(axis=1)
).flatten()
lib_size_tissue = lib_size[tissue_mask]

def get_log2_cpm(gene_name):
    if gene_name not in adata.raw.var_names:
        return None
    raw_exp = adata.raw[:, gene_name].X.toarray().flatten()
    cpm = raw_exp / lib_size * 1e4
    log2_cpm = np.log2(cpm + 1)
    return log2_cpm[tissue_mask]

additional_genes = ['EGFR', 'EPCAM', 'PTPRC', 'CD8A', 'MKI67']
available_additional = [g for g in additional_genes if g in adata.raw.var_names]
all_available_genes = [default_gene] + available_additional

gene_data = {}
for gene in all_available_genes:
    expr = get_log2_cpm(gene)
    if expr is not None:
        gene_data[gene] = expr.tolist()
    else:
        gene_data[gene] = [0.0] * len(coords_tissue)

gene_names_js = list(gene_data.keys())

# Data for Java

clusters = sorted(obs_tissue['leiden'].unique())
colors_plotly = px.colors.qualitative.Plotly
cluster_colors = {cl: colors_plotly[i % len(colors_plotly)] for i, cl in enumerate(clusters)}

cluster_counts = obs_tissue['leiden'].value_counts()
total_cells = len(obs_tissue)
cluster_info = {cl: {'count': int(cluster_counts[cl]), 'percent': (cluster_counts[cl] / total_cells) * 100} for cl in clusters}

spatial_coords = coords_tissue
umap_coords = adata.obsm['X_umap'][tissue_mask]

umap_x_min, umap_x_max = umap_coords[:, 0].min(), umap_coords[:, 0].max()
umap_y_min, umap_y_max = umap_coords[:, 1].min(), umap_coords[:, 1].max()
umap_padding = 0.1
umap_x_range = [
    umap_x_min - umap_padding * (umap_x_max - umap_x_min),
    umap_x_max + umap_padding * (umap_x_max - umap_x_min)
]
umap_y_range = [
    umap_y_min - umap_padding * (umap_y_max - umap_y_min),
    umap_y_max + umap_padding * (umap_y_max - umap_y_min)
]
umap_x_range = [float(x) for x in umap_x_range]
umap_y_range = [float(y) for y in umap_y_range]

coords_spatial_js = spatial_coords.tolist()
coords_umap_js = umap_coords.tolist()
clusters_js = [str(cl) for cl in obs_tissue['leiden'].tolist()]
cluster_colors_js = [cluster_colors[cl] for cl in obs_tissue['leiden'].tolist()]
unique_clusters_js = [str(c) for c in clusters]

hover_texts_cluster = []
for i, cl in enumerate(obs_tissue['leiden']):
    info = cluster_info[cl]
    cell_type = obs_tissue['pred_cell_type'].iloc[i]
    hover_texts_cluster.append(
        f"Cluster: {cl}<br>Cells: {info['count']} ({info['percent']:.1f}%)<br>Type: {cell_type}"
    )

cell_types_list = obs_tissue['pred_cell_type'].tolist()


# HTML Generation

