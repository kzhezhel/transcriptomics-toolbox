                <input type="text" id="gene-input" placeholder="Type gene name..." autocomplete="off">
                <div id="gene-dropdown" class="gene-dropdown"></div>
            </div>
        </div>
        <div id="pipeline-label" class="pipeline-label">Pipeline-generated groups</div>
    </div>
    <script>
        // Data from Python
        var spatialCoords = {json.dumps(coords_spatial_js)};
        var umapCoords = {json.dumps(coords_umap_js)};
        var clusters = {json.dumps(clusters_js)};
        var clusterColors = {json.dumps(cluster_colors_js)};
        var uniqueClusters = {json.dumps(unique_clusters_js)};
        var imgWidth = {img_width};
        var imgHeight = {img_height};
        var umapXRange = {umap_x_range};
        var umapYRange = {umap_y_range};
        var clusterHoverTexts = {json.dumps(hover_texts_cluster)};
        var cellTypes = {json.dumps(cell_types_list)};
        var geneData = {json.dumps(gene_data)};
        var geneNames = {json.dumps(gene_names_js)};

        var currentGene = '{default_gene}';
        var clusterColorMap = {{}};
        for (var i = 0; i < uniqueClusters.length; i++) {{
            var cl = uniqueClusters[i];
            var idx = clusters.indexOf(cl);
            clusterColorMap[cl] = clusterColors[idx];
        }}

        var currentMode = null;
        var clustersProjection = 'spatial';
        var sox2Projection = 'spatial';
        var currentOpacity = 0.7;

        function drawViolin(gene) {{
            var expr = geneData[gene];
            if (!expr) return;
            var valuesByCluster = {{}};
            for (var i = 0; i < clusters.length; i++) {{
                var cl = clusters[i];
                if (!valuesByCluster[cl]) valuesByCluster[cl] = [];
                valuesByCluster[cl].push(expr[i]);
            }}
            var sortedClusters = uniqueClusters.slice().sort((a,b)=>Number(a)-Number(b));
            var traces = [];
            for (var cls of sortedClusters) {{
                traces.push({{
                    type: 'violin',
                    y: valuesByCluster[cls],
                    name: 'Cluster ' + cls,
                    legendgroup: 'cluster_' + cls,
                    line: {{ color: clusterColorMap[cls], width: 1.5 }},
                    box: {{
                        visible: true,
                        line: {{ width: 1.5 }}
                    }},
                    meanline: {{
                        visible: true,
                        width: 1.5
                    }},
                    side: 'both',
                    showlegend: false
                }});
                traces.push({{
                    x: [null], y: [null],
                    mode: 'markers',
                    marker: {{ color: clusterColorMap[cls], size: 10, symbol: 'square' }},
                    name: 'Cluster ' + cls,
                    legendgroup: 'cluster_' + cls,
                    showlegend: true,
                    visible: false
                }});
            }}
            var maxVal = Math.max(...Object.values(valuesByCluster).flat());
            var layout = {{
                title: {{
                    text: gene + ' expression by cluster',
                    font: {{ size: 14, color: '#2c3e66' }},
                    x: 0.5
                }},
                xaxis: {{
                    title: {{font: {{ color: '#2c3e66' }} }},
                    tickfont: {{ color: '#2c3e66' }},
                    gridcolor: '#add8e6',
                    showgrid: false
                }},
                yaxis: {{
                    title: {{ text: 'log2', font: {{ color: '#2c3e66' }} }},
                    tickfont: {{ color: '#2c3e66' }},
                    range: [0, maxVal + 0.5],
                    gridcolor: '#e4ecf6'
                }},
                margin: {{ l: 40, r: 20, t: 40, b: 40 }},
                paper_bgcolor: 'white',
                plot_bgcolor: 'white',
                legend: {{ orientation: 'h', y: -0.2, x: 0.5, xanchor: 'center' }}
            }};
            Plotly.newPlot('violin-container', traces, layout, {{ responsive: true, displayModeBar: false }});
        }}
        function setToggleState(proj) {{
            var btns = document.querySelectorAll('.toggle-btn');
            btns.forEach(btn => {{
                if (btn.getAttribute('data-proj') === proj) btn.classList.add('active');
                else btn.classList.remove('active');
            }});
        }}

        function redraw() {{
            if (currentMode === 'clusters') {{
                var coords = clustersProjection === 'spatial' ? spatialCoords : umapCoords;
                var xRange = clustersProjection === 'spatial' ? [0, imgWidth] : umapXRange;
                var yRange = clustersProjection === 'spatial' ? [0, imgHeight] : umapYRange;
                var showImage = clustersProjection === 'spatial';
                var traces = [];
                for (var cl of uniqueClusters) {{
                    var indices = [];
                    for (var i = 0; i < clusters.length; i++) {{
                        if (clusters[i] === cl) indices.push(i);
                    }}
                    traces.push({{
                        x: indices.map(i => coords[i][0]), y: indices.map(i => coords[i][1]),
                        mode: 'markers', type: 'scattergl',
                        marker: {{ size: 6, color: clusterColorMap[cl], opacity: currentOpacity }},
                        name: 'Cluster ' + cl,
                        text: indices.map(i => clusterHoverTexts[i]),
                        hoverinfo: 'text',
                        showlegend: true
                    }});
                }}
                var layout = {{
                    width: document.getElementById('plotly-container').clientWidth,
                    height: document.getElementById('plotly-container').clientHeight,
                    xaxis: {{ range: xRange, visible: false, scaleanchor: 'y', scaleratio: 1, autorange: false }},
                    yaxis: {{ range: yRange, visible: false, scaleanchor: 'x', scaleratio: 1, autorange: false }},
                    margin: {{ l: 0, r: 0, t: 0, b: 0 }},
                    paper_bgcolor: 'rgba(0,0,0,0)',
                    plot_bgcolor: 'rgba(0,0,0,0)',
                    showlegend: true,
                    legend: {{
                        x: 0.1, y: 0.5, xanchor: 'left', yanchor: 'middle',
                        bgcolor: 'white', bordercolor: '#ddd', borderwidth: 0,
                        font: {{ size: 11 }}, tracegroupgap: 5, itemsizing: 'constant'
                    }},
                    images: showImage ? [{{
                        source: 'data:image/png;base64,{img_base64}',
                        xref: 'x', yref: 'y', x: 0, y: imgHeight,
                        sizex: imgWidth, sizey: imgHeight, sizing: 'stretch', layer: 'below'
                    }}] : []
                }};
                Plotly.react('plotly-container', traces, layout, {{ responsive: true, displayModeBar: 'hover' }});
            }} else if (currentMode === 'sox2') {{
                var coords = sox2Projection === 'spatial' ? spatialCoords : umapCoords;
                var xRange = sox2Projection === 'spatial' ? [0, imgWidth] : umapXRange;
                var yRange = sox2Projection === 'spatial' ? [0, imgHeight] : umapYRange;
                var showImage = sox2Projection === 'spatial';
                var expr = geneData[currentGene];
                var minVal = Math.min(...expr);
                var maxVal = Math.max(...expr);
                var trace = {{
                    x: coords.map(c => c[0]), y: coords.map(c => c[1]),
                    mode: 'markers', type: 'scattergl',
                    marker: {{
                        size: 6, color: expr, colorscale: 'Viridis', showscale: false,
                        opacity: currentOpacity, cmin: minVal, cmax: maxVal
                    }},
                    text: expr.map((val, idx) => `${{currentGene}}: ${{val.toFixed(2)}}<br>Type: ${{cellTypes[idx]}}`),
                    hoverinfo: 'text',
                    name: currentGene,
                    showlegend: false
                }};
                var layout = {{
                    width: document.getElementById('plotly-container').clientWidth,
                    height: document.getElementById('plotly-container').clientHeight,
                    xaxis: {{ range: xRange, visible: false, scaleanchor: 'y', scaleratio: 1, autorange: false }},
                    yaxis: {{ range: yRange, visible: false, scaleanchor: 'x', scaleratio: 1, autorange: false }},
                    margin: {{ l: 0, r: 0, t: 0, b: 0 }},
                    paper_bgcolor: 'rgba(0,0,0,0)',
                    plot_bgcolor: 'rgba(0,0,0,0)',
                    showlegend: false,
                    images: showImage ? [{{
                        source: 'data:image/png;base64,{img_base64}',
                        xref: 'x', yref: 'y', x: 0, y: imgHeight,
                        sizex: imgWidth, sizey: imgHeight, sizing: 'stretch', layer: 'below'
                    }}] : []
                }};
                Plotly.react('plotly-container', [trace], layout, {{ responsive: true, displayModeBar: 'hover' }});
            }}
        }}

        function switchProjection(proj) {{
            if (currentMode === 'clusters') {{
                clustersProjection = proj;
                setToggleState(proj);
                redraw();
            }} else if (currentMode === 'sox2') {{
                sox2Projection = proj;
                setToggleState(proj);
                redraw();
            }}
        }}

        function changeGene(gene) {{
            if (!geneData.hasOwnProperty(gene)) {{
                console.warn("Gene not available:", gene);
                return;
            }}
            currentGene = gene;
            // update color range
            var expr = geneData[gene];
            var minVal = Math.min(...expr);
            var maxVal = Math.max(...expr);
            document.getElementById('colorbar-title').innerText = gene + ' log2 ';
            document.getElementById('colorbar-max').innerText = maxVal.toFixed(1);
            document.getElementById('colorbar-min').innerText = minVal.toFixed(1);
            if (currentMode === 'sox2') {{
                redraw();
            }}
            drawViolin(gene);
        }}

        function showClusters() {{
            document.getElementById('image-container').style.display = 'none';
            document.getElementById('plotly-container').style.display = 'block';
            document.getElementById('opacity-slider-container').style.display = 'block';
            document.getElementById('custom-colorbar').style.display = 'none';
            document.getElementById('gene-search').style.display = 'none';
            document.getElementById('pipeline-label').style.display = 'block';
            currentMode = 'clusters';
            setToggleState(clustersProjection);
            redraw();
        }}

        function showSox2() {{
            document.getElementById('image-container').style.display = 'none';
            document.getElementById('plotly-container').style.display = 'block';
            document.getElementById('opacity-slider-container').style.display = 'block';
            document.getElementById('custom-colorbar').style.display = 'flex';
            document.getElementById('gene-search').style.display = 'flex';
            document.getElementById('pipeline-label').style.display = 'none';
            currentMode = 'sox2';
            setToggleState(sox2Projection);
            updateColorbar(currentGene);
            redraw();
            drawViolin(currentGene);
        }}

        function showImage() {{
            document.getElementById('image-container').style.display = 'flex';
            document.getElementById('plotly-container').style.display = 'none';
            document.getElementById('opacity-slider-container').style.display = 'none';
            document.getElementById('custom-colorbar').style.display = 'none';
            document.getElementById('gene-search').style.display = 'none';
            document.getElementById('pipeline-label').style.display = 'none';
            currentMode = null;
        }}

        function updateOpacity() {{
            var slider = document.getElementById('opacity-slider');
            currentOpacity = parseFloat(slider.value);
            document.getElementById('opacity-value').innerText = currentOpacity.toFixed(2);
            if (currentMode === 'clusters') {{
                var indices = [];
                for (var i = 0; i < uniqueClusters.length; i++) indices.push(i);
                Plotly.restyle('plotly-container', {{ 'marker.opacity': currentOpacity }}, indices);
            }} else if (currentMode === 'sox2') {{
                Plotly.restyle('plotly-container', {{ 'marker.opacity': currentOpacity }}, [0]);
            }}
        }}

        function updateColorbar(gene) {{
            var expr = geneData[gene];
            var minVal = Math.min(...expr);
            var maxVal = Math.max(...expr);
            document.getElementById('colorbar-title').innerText = gene + ' log2';
            document.getElementById('colorbar-max').innerText = maxVal.toFixed(1);
            document.getElementById('colorbar-min').innerText = minVal.toFixed(1);
        }}

        // Gene search
        var geneInput = document.getElementById('gene-input');
        var geneDropdown = document.getElementById('gene-dropdown');
        var allGeneNames = geneNames;

        function filterGenes(searchText) {{
            var searchLower = searchText.toLowerCase();
            return allGeneNames.filter(g => g.toLowerCase().includes(searchLower));
        }}
        function showDropdown(items) {{
            geneDropdown.innerHTML = '';
            if (items.length === 0) {{
                geneDropdown.style.display = 'none';
                return;
            }}
            items.forEach(item => {{
                var div = document.createElement('div');
                div.textContent = item;
                div.addEventListener('click', function() {{
                    geneInput.value = item;
                    geneDropdown.style.display = 'none';
                    changeGene(item);
                }});
                geneDropdown.appendChild(div);
            }});
            geneDropdown.style.display = 'block';
        }}
        geneInput.addEventListener('input', function() {{
            var filtered = filterGenes(this.value);
            showDropdown(filtered);
        }});
        geneInput.addEventListener('blur', function() {{
            setTimeout(() => {{ geneDropdown.style.display = 'none'; }}, 200);
        }});
        geneInput.addEventListener('keydown', function(e) {{
            if (e.key === 'Enter' && geneDropdown.children.length > 0) {{
                var firstOption = geneDropdown.children[0];
                geneInput.value = firstOption.textContent;
                geneDropdown.style.display = 'none';
                changeGene(firstOption.textContent);
            }}
        }});
        geneInput.value = '{default_gene}';

        window.addEventListener('load', function() {{
            document.getElementById('btn-clusters').onclick = showClusters;
            document.getElementById('btn-feature').onclick = showSox2;
            document.getElementById('btn-patch').onclick = showImage;
            document.getElementById('opacity-slider').addEventListener('input', updateOpacity);
            document.querySelectorAll('.toggle-btn').forEach(btn => {{
                btn.addEventListener('click', function() {{
                    switchProjection(this.getAttribute('data-proj'));
                }});
            }});
            window.addEventListener('resize', function() {{
                if (document.getElementById('plotly-container').style.display === 'block') redraw();
            }});
            showImage();
        }});
    </script>
</body>
</html>
"""

# Save and open
with open(output_file, "w", encoding="utf-8") as f:
    f.write(html_content)

print(f"HTML dashboard saved to: {output_file}")
webbrowser.open("file://" + os.path.abspath(output_file))
